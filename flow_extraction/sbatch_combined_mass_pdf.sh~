#!/bin/bash
#SBATCH --job-name=plot_stitch
#SBATCH --output=stitch_%j.out
#SBATCH --error=stitch_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=64
#SBATCH --mem=64G
#SBATCH --time=01:00:00
#SBATCH -A physics
#SBATCH -p cpu
#SBATCH -q standby

# Load necessary modules
module purge
module load texlive parallel

# --- CONFIGURATION ---
PLOT_SOURCE_DIR="/scratch/negishi/saha115/D0_ESE_out/CMSSW_13_2_11/src/Flow_output_Mar4_v0/output/prompt_mass_plot_withchi2_sigma"
PLOTS_PER_PAGE=100
GRID="10x10"
FINAL_OUTPUT="All_Plots_Combined.pdf"
TEMP_DIR="temp_parallel_$SLURM_JOB_ID"

# Fix Perl environment for GNU Parallel
unset PERL5LIB

# Setup
mkdir -p $TEMP_DIR

# --- Build ordered file list: cent -> pt -> q2bin -> v2bin ---
# Centrality task IDs (0=0-10%, 1=10-20%, 2=20-30%, 3=30-40%, 4=40-50%, 5=50-80%)
CEN_IDS="0 1 2 3 4 5"

# pT bin names in physics order (must match pt_name[] in Analysis_bin.h)
PT_NAMES="pT1to2 pT2to3 pT3to4 pT4to5 pT5to6 pT6to8 pT8to10 pT10to15 pT15to20 pT20to40 pT40to60 pT60to100"

# Number of q2 bins and v2 bins (must match N_QBINS and N_VBINS)
N_QBINS=10    # adjust to your actual N_QBINS
N_VBINS=62   # adjust to your actual N_VBINS

ORDERED_LIST="ordered_files_$SLURM_JOB_ID.txt"
> "$ORDERED_LIST"

for cen_id in $CEN_IDS; do
  for pt in $PT_NAMES; do
    for (( iq=0; iq<N_QBINS; iq++ )); do
      for (( iv=0; iv<N_VBINS; iv++ )); do
        # filename pattern: {TASK_ID}_hmassfit_{pt_name}_{cen_name}_q2bin_{i_q}_v2bin_{i_v}.pdf
        # We use glob to find the matching file regardless of cen_name string
        found=$(ls "$PLOT_SOURCE_DIR"/${cen_id}_hmassfit_${pt}_*_q2bin_${iq}_v2bin_${iv}.pdf 2>/dev/null | head -1)
        if [ -n "$found" ]; then
          echo "$found" >> "$ORDERED_LIST"
        fi
      done
    done
  done
done

TOTAL_PLOTS=$(wc -l < "$ORDERED_LIST")
echo "Job started on $(hostname)"
echo "Processing $TOTAL_PLOTS plots using $SLURM_CPUS_PER_TASK cores."

# Define the worker function
process_batch() {
    unset PERL5LIB
    local start_line=$1
    local batch_size=$2
    local grid=$3
    local temp_dir=$4
    local job_id=$5
    local ordered_list=$6
    local batch_num=$((start_line / batch_size))
    local output_page=$(printf "$temp_dir/page_%04d.pdf" $batch_num)

    sed -n "$((start_line + 1)),$((start_line + batch_size))p" "$ordered_list" > "list_${job_id}_${batch_num}.txt"

    pdfjam $(cat "list_${job_id}_${batch_num}.txt") --nup $grid --papersize '{20in,20in}' --outfile "$output_page" > /dev/null 2>&1

    rm "list_${job_id}_${batch_num}.txt"
}

export -f process_batch

# Run in Parallel
seq 0 $PLOTS_PER_PAGE $((TOTAL_PLOTS - 1)) | parallel -j $SLURM_CPUS_PER_TASK --bar \
  process_batch {} $PLOTS_PER_PAGE $GRID $TEMP_DIR $SLURM_JOB_ID $ORDERED_LIST

# Final Merge
echo "Merging pages into $FINAL_OUTPUT..."
pdfjam $TEMP_DIR/page_*.pdf --outfile "$FINAL_OUTPUT" > /dev/null 2>&1

# Cleanup
rm -rf $TEMP_DIR "$ORDERED_LIST"
echo "Job Completed."
