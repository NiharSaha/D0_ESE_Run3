#include <vector>
#include <algorithm>
#include <iostream>
#include <fstream>
#include "TH1D.h"
#include "TFile.h"
#include "TNtuple.h"
#include "TSystem.h"

void process_quantiles(int centBin) {

  // 1. Open input file (Update path as needed)
    TFile *fIn = TFile::Open("/scratch/negishi/saha115/D0_ESE_out/CMSSW_13_2_11/src/Quantiles_MB11to21_Jan30_v3/ROOT/Quantiles_ESE_out_combined.root", "READ");
    if (!fIn) return;

    // 2. Get the Ntuple for this 1% bin
    TNtuple *nt = (TNtuple*)fIn->Get(Form("Q_ntuple/nt_qn_cent%d", centBin));
    if (!nt || nt->GetEntries() == 0) {
        std::cout << "Bin " << centBin << " empty or missing." << std::endl;
        return;
    }

    std::vector<double> vQ2, vQ3;
    float q2_val, q3_val, q2_hfp, q2_hfm; // Adjust based on your nt->Fill() order
    nt->SetBranchAddress("q2_tot", &q2_val);
    nt->SetBranchAddress("q3_tot", &q3_val);

    // 3. Extract and Sort (The "Negishi" method)
    for (int i=0; i < nt->GetEntries(); i++) {
        nt->GetEntry(i);
        if (q2_val > -1.0) vQ2.push_back((double)q2_val);
        if (q3_val > -1.0) vQ3.push_back((double)q3_val);
    }
    std::sort(vQ2.begin(), vQ2.end());
    std::sort(vQ3.begin(), vQ3.end());

    // 4. Calculate exact quantile boundaries
    double cuts2[11], cuts3[11];
    int n2 = vQ2.size();
    int n3 = vQ3.size();
    for (int k = 0; k <= 10; k++) {
        int idx2 = (k == 10) ? n2 - 1 : (k * n2 / 10);
        int idx3 = (k == 10) ? n3 - 1 : (k * n3 / 10);
        cuts2[k] = (n2 > 0) ? vQ2[idx2] : 0;
        cuts3[k] = (n3 > 0) ? vQ3[idx3] : 0;
    }

    if (gSystem->AccessPathName("temp_cuts")) gSystem->mkdir("temp_cuts");
    if (gSystem->AccessPathName("temp_roots")) gSystem->mkdir("temp_roots");

    
    // 5. Save cuts to a temporary text snippet for the header later
    ofstream outCut(Form("temp_cuts/cuts_bin%d.txt", centBin));
    for (int k=0; k<=10; k++) outCut << cuts2[k] << (k==10?"":",");
    outCut << endl;
    for (int k=0; k<=10; k++) outCut << cuts3[k] << (k==10?"":",");
    outCut.close();

    // 6. Create Output Histograms
    TFile *fOut = new TFile(Form("temp_roots/hist_bin%d.root", centBin), "RECREATE");
    
    // Total 1% Distributions
    TH1D *hTotalQ2 = new TH1D(Form("hRawQ2_c%d", centBin), "", 7000, 0, 0.7);
    TH1D *hTotalQ3 = new TH1D(Form("hRawQ3_c%d", centBin), "", 7000, 0, 0.7);

    // Quantile Slices (10 for each)
    TH1D *hSliceQ2[10], *hSliceQ3[10];
    for(int k=0; k<10; k++) {
        hSliceQ2[k] = new TH1D(Form("hSliceQ2_c%d_q%d", centBin, k+1), "", 7000, 0, 0.7);
        hSliceQ3[k] = new TH1D(Form("hSliceQ3_c%d_q%d", centBin, k+1), "", 7000, 0, 0.7);
    }

    // 7. Fill Histograms from sorted vectors
    for (double val : vQ2) {
        hTotalQ2->Fill(val);
        for (int k=0; k<10; k++) {
            if (val >= cuts2[k] && val < cuts2[k+1]) { hSliceQ2[k]->Fill(val); break; }
        }
    }
    for (double val : vQ3) {
        hTotalQ3->Fill(val);
        for (int k=0; k<10; k++) {
            if (val >= cuts3[k] && val < cuts3[k+1]) { hSliceQ3[k]->Fill(val); break; }
        }
    }

    fOut->Write();
    fOut->Close();
    fIn->Close();
}
