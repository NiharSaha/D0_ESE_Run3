    TH1D *h_v3_full = new TH1D(hname_v3, TString::Format("v3 dist %s %s;v3;Counts", cen_name[i_cen], pt_name[i_pt]), 80, -20, 20);
    nt->Draw(TString::Format("v2>>%s", hname_v2.Data()), cuts, "goff");
