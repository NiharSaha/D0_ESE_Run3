    lat2.DrawLatex(0.15, 0.82, TString::Format("Entries=%.0f  Mean=%.3f  RMS=%.3f",
        h_v2_full->GetEntries(), h_v2_full->GetMean(), h_v2_full->GetRMS()));
    {
