    lat3.DrawLatex(0.15, 0.82, TString::Format("Entries=%.0f  Mean=%.3f  RMS=%.3f",
        h_v3_full->GetEntries(), h_v3_full->GetMean(), h_v3_full->GetRMS()));
    {
      std::string pdfname = plotdir + TString::Format("/v3dist_c%d_pt%d.pdf", i_cen, i_pt).Data();
